# Copy to .env (git-ignored). docker compose reads it automatically.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# true = TLS on connect (port 465); false = STARTTLS (port 587)
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change-me
MAIL_FROM_NAME=Fincore
# Sender address; defaults to SMTP_USER
# MAIL_FROM_ADDRESS=no-reply@example.com
# Failed emails are retried (30s, 1m, 2m, 4m ... up to 1h apart) until MAIL_MAX_ATTEMPTS
MAIL_MAX_ATTEMPTS=8
MAIL_DISPATCH_DELAY=PT5S

# Guest payments (Razorpay dashboard > Settings > API Keys; use test keys while developing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > add https://<public host>/api/v1/webhooks/razorpay, events payment.captured and order.paid
RAZORPAY_WEBHOOK_SECRET=
# Signs fixed-amount payment links; any long random string (openssl rand -hex 32)
QR_SIGNING_SECRET=
