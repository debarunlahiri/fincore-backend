# Copy to .env.tunnel (git-ignored) to use a stable public hostname.
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > "Install and run a connector": copy the token from the command.
CLOUDFLARE_TUNNEL_TOKEN=
# The public hostname you mapped to http://localhost:9780 in the tunnel's "Public Hostname" tab, shown in the instructions.
TUNNEL_PUBLIC_URL=https://api.example.com
